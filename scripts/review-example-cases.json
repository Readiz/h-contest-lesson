    "body": "\nmt19937 gen(3);for(int n=2;n<=7;n++)for(int trial=0;trial<15;trial++){\n vector<vector<long long>> w(n,vector<long long>(n));for(int i=0;i<n;i++)for(int j=0;j<i;j++)w[i][j]=w[j][i]=gen()%6;\n auto oracle=[&](int s,int t){long long best=LLONG_MAX;int chosen=0;for(int mask=1;mask<(1<<n)-1;mask++)if((mask>>s&1)&&!(mask>>t&1)){long long v=0;for(int i=0;i<n;i++)for(int j=0;j<i;j++)if(((mask>>i)^(mask>>j))&1)v+=w[i][j];if(v<best){best=v;chosen=mask;}}vector<int>side(n);for(int i=0;i<n;i++)side[i]=chosen>>i&1;return MinCutResult{best,side};};\n GomoryHuTree g(n,oracle);auto edges=g.build();assert(edges==g.build());vector<vector<pair<int,long long>>>tree(n);for(auto [a,b,c]:edges){tree[a].push_back({b,c});tree[b].push_back({a,c});}\n for(int s=0;s<n;s++){vector<long long>d(n,-1);function<void(int,int,long long)> dfs=[&](int u,int p,long long v){d[u]=v;for(auto [to,c]:tree[u])if(to!=p)dfs(to,u,min(v,c));};dfs(s,-1,LLONG_MAX);for(int t=0;t<n;t++)if(t!=s)assert(d[t]==oracle(s,t).value);}\n}\n",
